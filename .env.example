# Copy to .env and fill in. Never commit .env.

# ── Agora Conversational AI (required for live voice) ──────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_REST_KEY=
AGORA_REST_SECRET=

# ── LLMs ────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Small fast model that turns each buyer turn into structured signals (falls back to rules on timeout)
EXTRACTION_MODEL=qwen/qwen3.8-27b
EXTRACTION_TIMEOUT_SECONDS=0.6
# Fallback when Groq fails before answering
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# ── Security ────────────────────────────────────────────────────
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LIVELY_LLM_SHARED_SECRET=lively-custom-llm-secret-9988
SESSION_SECRET=lively-prod-session-secret-99887766
REQUIRE_LLM_SECRET=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public URL Agora uses to reach /v1/chat/completions (run.bat fills this in from the tunnel)
BACKEND_PUBLIC_URL=http://localhost:8000

# ── Calendar ────────────────────────────────────────────────────
MEETING_ROOM_BASE_URL=https://meet.jit.si
CALENDAR_WORKING_DAYS=mon,tue,wed,thu,fri
CALENDAR_SLOT_TIMES=10:00,14:00,16:00

# ── Email (optional; without it invites are saved as local previews) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# AE inbox that receives the handoff summary on escalation
ESCALATION_NOTIFY_EMAIL=

# ── CRM (optional HubSpot private-app token) ────────────────────
HUBSPOT_ACCESS_TOKEN=

# ── Optional storage ────────────────────────────────────────────
DATABASE_URL=
REDIS_URL=
PINECONE_API_KEY=
